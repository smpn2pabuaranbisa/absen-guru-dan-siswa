# ==========================================================
# KONFIGURASI MASTER SIMS SEKOLAH (MODEL A - MULTI-INSTANCE)
# ==========================================================
# Salin file ini menjadi .env sebelum menjalankan aplikasi:
# cp .env.example .env

PORT=3000
NODE_ENV=development

# 1. IDENTITAS SEKOLAH
VITE_APP_TITLE="Sistem Presensi & Informasi Manajemen Sekolah"
VITE_SCHOOL_NAME="SMPN 2 PABUARAN SERANG"
VITE_SCHOOL_NPSN="20605159"

# 2. DATABASE POSTGRESQL 16 (Sumopod.com / VPS / Cloud SQL / Supabase)
# Format URL Koneksi: postgres://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
# Contoh Sumopod: postgres://admin_sekolah:K4t4S4nd1Kuat@pgsql.sumopod.com:5432/sims_db
DATABASE_URL="postgres://postgres:password@localhost:5432/sims_sekolah"
# Atur DB_SSL=true jika server Sumopod Anda mewajibkan koneksi SSL
DB_SSL=false

# 3. PENYIMPANAN FOTO GOOGLE DRIVE (GOOGLE APPS SCRIPT WEBHOOK)
# Dapatkan URL ini setelah menerapkan (deploy) skrip di Google Drive sekolah
GDRIVE_UPLOAD_WEBHOOK="https://script.google.com/macros/s/AKfycbwulhlEO-WHDCBUdlXjO_R89m8ycvQM82OUlvgrw2t1Le0JikOxW_uJiyENIlYC1blH/exec"
